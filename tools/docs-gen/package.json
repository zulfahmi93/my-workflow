{
  "name": "docs-gen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared config-driven static-HTML generator for project build-plan docs (single-file plan-NNN.yaml → offline per-project docs sites).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node generate.mjs",
    "watch": "node generate.mjs --watch",
    "validate": "node generate.mjs --validate",
    "validate-cycle-note": "node scripts/validate-cycle-note.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "chokidar": "^4.0.3",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "yaml": "^2.9.0"
  }
}
