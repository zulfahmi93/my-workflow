# Per-project repos are versioned independently (each projects/<name> is its own git repo).
# The root repo tracks shared infra: tools/, .agents/, provider adapters, wiki/, and allowlisted docs/.
/projects/

# Secrets — never commit
/secrets/
.env
.env.*
*.key
*.pem

# Dependencies
node_modules/

# Generated documentation output
/tools/docs-gen/README.html

# Claude local / runtime (user-specific, per .agents/rules/commit.md)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Large binary assets (version via Git LFS if needed)
/docs/profiles/

# Documentation is private/local by default. Explicitly allow shared folders.
/docs/*
!/docs/templates/
!/docs/templates/**

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Session scratchpad leaked into the repo. The scratchpad lives at an ABSOLUTE path under
# /private/tmp/claude-501/, but a tool invoked with the leading slash dropped writes a literal
# `private/tmp/...` tree inside the repo root instead. Commit dd57513 swept 36 such generated
# files (19,610 lines) in via a `git add -A` that ran in the wrong working directory.
/private/
